---
export const prerender = true;

import BaseLayout from "@layouts/BaseLayout.astro";
import FeedCard from "@components/FeedCard.astro";
import Pagination from "@components/Pagination.astro";
import { paginationCacheKey, getPage, PAGE_SIZE } from "@lib/pagination";
import { renderKey, type DocumentData } from "@lib/farfield-loader";
import { documentsByTag } from "@lib/content-query";

export async function getStaticPaths() {
    const byTag = await documentsByTag();
    const paths = [];
    for (const [tag, items] of byTag) {
        const totalPages = Math.max(1, Math.ceil(items.length / PAGE_SIZE));
        for (let page = 1; page <= totalPages; page++) {
            const slice = items.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
            paths.push({
                params: {
                    tag,
                    page: page === 1 ? undefined : `page/${page}`,
                },
                props: { tag, items, page },
                cacheKey: paginationCacheKey(page, totalPages, slice.map(renderKey)),
            });
        }
    }
    return paths;
}

const { tag, items, page } = Astro.props as {
    tag: string;
    items: DocumentData[];
    page: number;
};

const base = `/tags/${encodeURIComponent(tag)}`;
const paged = getPage(items, page, base)!;
---

<BaseLayout
    title={page > 1 ? `#${tag} — page ${page}` : `#${tag}`}
    description={`Entries tagged ${tag} — iammatthias.`}
    breadcrumbs={[
        { label: "tags", href: "/tags" },
        { label: tag },
    ]}
    pagination={{ prev: paged.prevHref, next: paged.nextHref }}
>
    <header class="page-header">
        <h1>{tag}</h1>
        <p class="meta">
            <a href={`${base}/rss.xml`}>RSS</a>
            <span aria-hidden="true"> · </span>
            <span>{paged.total} {paged.total === 1 ? "entry" : "entries"}</span>
        </p>
    </header>

    <ul class="feed-grid">
        {paged.items.map((item) => (
            <FeedCard
                href={item.href}
                title={item.title}
                description={item.description}
                publishedAt={item.publishedAt}
                kind={item.publication.name.toLowerCase()}
                draft={item.published === false}
            />
        ))}
    </ul>

    <Pagination
        page={paged.page}
        totalPages={paged.totalPages}
        basePath={base}
    />
</BaseLayout>
