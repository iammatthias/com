---
export const prerender = false;

import ContentIndex from "@components/ContentIndex.astro";
import { loadContentIndex } from "@lib/content-index";
import { getPage } from "@lib/pagination";
import { setDocumentPageCacheHeaders } from "@lib/cache";

const page = Number(Astro.params.page);
if (!Number.isInteger(page) || page < 2 || String(page) !== Astro.params.page) {
    return new Response(null, { status: 404 });
}
const data = await loadContentIndex();
const paged = getPage(data.items, page, "/content");
if (!paged) return new Response(null, { status: 404 });
setDocumentPageCacheHeaders(Astro.response);
---

<ContentIndex paged={paged} pubs={data.pubs} />
