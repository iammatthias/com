---
// Tag cloud, prerendered from the build-time docs collection.
export const prerender = true;

import BaseLayout from "@layouts/BaseLayout.astro";
import type { MenuMeta } from "@lib/menu";
import { documentsByTag } from "@lib/content-query";

export const menu: MenuMeta = { group: "archive", order: 2 };

const byTag = await documentsByTag();
const tags = [...byTag.entries()]
    .map(([tag, list]) => ({ tag, count: list.length }))
    .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));
---

<BaseLayout title="Tags" description="All tags across the site, by frequency.">
    <header class="page-header">
        <h1>Tags</h1>
        <p>{tags.length} unique tags across the archive.</p>
    </header>

    {tags.length === 0 ? (
        <p class="feed-empty">No tags yet.</p>
    ) : (
        <ul class="tag-cloud">
            {tags.map(({ tag, count }) => (
                <li>
                    <a href={`/tags/${encodeURIComponent(tag)}`}>
                        <span class="tag-name">{tag}</span>
                        <span class="tag-count">{count}</span>
                    </a>
                </li>
            ))}
        </ul>
    )}
</BaseLayout>

<style>
    /* `.page-header` + `.feed-empty` live in globals.css. The
       per-page header italics override below tightens the muted
       `<p>` for this surface — it's a stat line, not prose. */
    .page-header p {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: var(--fs-sm);
    }

    .tag-cloud {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-3);
    }

    .tag-cloud li {
        list-style: none;
    }

    .tag-cloud a {
        display: inline-flex;
        align-items: baseline;
        gap: 0.4em;
        text-decoration: none;
    }

    /* The underline lands on the span (only the name, not the count),
       so the base anchor's offset doesn't reach it — restate it. */
    .tag-cloud a:hover .tag-name {
        text-decoration: underline;
        text-underline-offset: 0.15em;
    }

    .tag-name {
        font-family: var(--font-serif);
    }

    .tag-count {
        font-size: var(--fs-xs);
        color: var(--color-muted);
        font-variant-numeric: tabular-nums;
    }
</style>
