---
export interface ColophonField {
    label: string;
    value: string;
    href?: string;
    datetime?: string;
}

interface Props {
    seed: number;
    fields: ColophonField[];
}

const { seed, fields } = Astro.props;
---

<footer class="colophon">
    <div class="colophon-banner" data-terrazzo data-seed={seed}></div>
    <dl class="colophon-meta">
        {fields.map((f) => (
            <div>
                <dt>{f.label}</dt>
                <dd>
                    {f.href ? (
                        <a href={f.href} rel="noopener">{f.value}</a>
                    ) : f.datetime ? (
                        <time datetime={f.datetime}>{f.value}</time>
                    ) : (
                        f.value
                    )}
                </dd>
            </div>
        ))}
    </dl>
</footer>

<script>
    import { mountTerrazzoBanners } from "@src/scripts/terrazzo";
    mountTerrazzoBanners();
</script>

<style>
    .colophon {
        padding-top: var(--space-5);
        border-top: 1px solid var(--color-border);
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
        gap: var(--space-5);
        align-items: stretch;
    }

    @media (max-width: 640px) {
        .colophon {
            grid-template-columns: 1fr;
        }
    }

    .colophon-banner {
        position: relative;
        overflow: hidden;
        border-radius: var(--radius);
        min-height: 140px;
        background: var(--color-border);
    }

    @media (max-width: 640px) {
        .colophon-banner {
            height: 96px;
            min-height: 0;
        }
    }

    .colophon-meta {
        font-family: var(--font-mono);
        font-size: var(--fs-xs);
        line-height: var(--lh-normal);
        color: var(--color-muted);
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .colophon-meta > div {
        display: flex;
        flex-direction: column;
        gap: 0.15em;
        word-break: break-all;
    }

    .colophon-meta dt {
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-size: var(--fs-xs);
        color: var(--color-muted);
        opacity: 0.7;
    }

    .colophon-meta dd {
        margin: 0;
        color: var(--color-fg);
    }

    .colophon-meta a {
        color: inherit;
    }
</style>
