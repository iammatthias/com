  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "rm -rf dist .astro && astro build && node scripts/agent-check.mjs",
    "build:force": "rm -rf dist .astro node_modules/.astro && astro build --force && node scripts/agent-check.mjs",
    "preview": "astro preview",
    "smoke": "node scripts/smoke.mjs",
    "overflow": "node scripts/overflow-check.mjs",
    "astro": "astro",
    "snapshot:azulejos": "node scripts/snapshot-azulejos.mjs",
    "snapshot:terrazzo": "node scripts/snapshot-terrazzo.mjs",
