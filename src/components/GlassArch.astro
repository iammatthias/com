---
---

<figure class="hero">
    <div class="arch-frame">
        <div class="arch-window" data-glass-window></div>
    </div>

    <figcaption data-glass-caption hidden></figcaption>
</figure>

<script>
    interface GlassPick {
        src: string;
        srcset: string;
        sizes: string;
        width: number;
        height: number;
        alt: string;
        prominentColor: string | null;
        seriesTitle: string | null;
        shareUrl: string | null;
        equipment: string | null;
        settings: string | null;
        captureDate: string | null;
    }

    async function hydrateGlass() {
        const win = document.querySelector("[data-glass-window]");
        const cap = document.querySelector("[data-glass-caption]");
        if (!(win instanceof HTMLElement)) return;

        let pick: GlassPick | null = null;
        try {
            const res = await fetch("/api/glass-pick.json");
            if (res.ok) pick = (await res.json()) as GlassPick;
        } catch {
            return;
        }
        if (!pick) return;

        if (pick.prominentColor) {
            win.style.background = pick.prominentColor;
            win.style.borderColor = pick.prominentColor;
        }

        const img = document.createElement("img");
        img.src = pick.src;
        img.srcset = pick.srcset;
        img.sizes = pick.sizes;
        img.width = pick.width;
        img.height = pick.height;
        img.alt = pick.alt;
        img.loading = "eager";
        img.decoding = "async";
        img.setAttribute("fetchpriority", "high");
        win.appendChild(img);

        if (!(cap instanceof HTMLElement)) return;
        const parts: HTMLElement[] = [];
        if (pick.seriesTitle) {
            const span = document.createElement("span");
            span.className = "title";
            if (pick.shareUrl) {
                const a = document.createElement("a");
                a.href = pick.shareUrl;
                a.rel = "noopener";
                a.textContent = pick.seriesTitle;
                span.appendChild(a);
            } else {
                span.textContent = pick.seriesTitle;
            }
            parts.push(span);
        }
        for (const line of [
            pick.equipment,
            pick.settings,
            pick.captureDate,
        ]) {
            if (!line) continue;
            const s = document.createElement("span");
            s.textContent = line;
            parts.push(s);
        }
        if (parts.length > 0) {
            cap.replaceChildren(...parts);
            cap.hidden = false;
        }
    }

    hydrateGlass();
</script>

<style>
    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-5);
        margin: 0;
        width: 100%;
    }

    .arch-frame {
        height: 70dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
    }

    .arch-window {
        aspect-ratio: 6 / 7;
        height: 100%;
        width: auto;
        max-width: 100%;

        border-top-left-radius: 50% calc(300% / 7);
        border-top-right-radius: 50% calc(300% / 7);

        overflow: hidden;
        background: var(--color-border);
        border: 6px solid var(--color-border);
    }

    .arch-window :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    figcaption {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.15em;
        text-align: center;
        font-size: var(--fs-xs);
        line-height: var(--lh-relaxed);
        color: var(--color-muted);
        text-wrap: balance;
    }

    figcaption :global(.title) {
        color: var(--color-fg);
        font-weight: var(--fw-medium);
    }

</style>
