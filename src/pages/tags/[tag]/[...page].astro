---
export const prerender = false;

import BaseLayout from "@layouts/BaseLayout.astro";
import Deck from "@components/Deck.astro";
import FeedCard from "@components/FeedCard.astro";
import Pagination from "@components/Pagination.astro";
import { getPage, parsePageParam } from "@lib/pagination";
import { documentsByTag } from "@lib/content-query";
import { setDocumentPageCacheHeaders } from "@lib/cache";

const tag = Astro.params.tag ?? "";
const page = parsePageParam(Astro.params.page);
const items = (await documentsByTag()).get(tag);
if (page === null || !items?.length) return new Response(null, { status: 404 });

const base = `/tags/${encodeURIComponent(tag)}`;
const paged = getPage(items, page, base);
if (!paged) return new Response(null, { status: 404 });
setDocumentPageCacheHeaders(Astro.response);

---

<BaseLayout
    deck
    title={page > 1 ? `#${tag} — page ${page}` : `#${tag}`}
    description={`Entries tagged ${tag} — iammatthias.`}
    breadcrumbs={[
        { label: "tags", href: "/tags" },
        { label: tag },
    ]}
    pagination={{ prev: paged.prevHref, next: paged.nextHref }}
>
    <Deck>
    <header class="page-header">
        <h1>{tag}</h1>
        <p class="meta">
            <a href={`${base}/rss.xml`}>RSS</a>
            <span aria-hidden="true"> · </span>
            <span>{paged.total} {paged.total === 1 ? "entry" : "entries"}</span>
        </p>
    </header>

    <ul class="grid">
        {paged.items.map((item) => (
            <FeedCard
                href={item.href}
                title={item.title}
                description={item.description}
                publishedAt={item.publishedAt}
                kind={item.publication.name.toLowerCase()}
                draft={item.published === false}
            />
        ))}
    </ul>

    <Pagination
        page={paged.page}
        totalPages={paged.totalPages}
        basePath={base}
    />
    </Deck>
</BaseLayout>
