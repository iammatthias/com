---
import { getMenuGroups } from "@lib/site-menu";

const groups = await getMenuGroups();
---

<nav class="menu-links" aria-label="Site navigation">
    {groups.map((group) => (
        <section>
            {group.label && <h2>{group.label}</h2>}
            <ul>
                {group.links.map((link) => (
                    <li>
                        <a href={link.href}>{link.label}</a>
                    </li>
                ))}
            </ul>
        </section>
    ))}
</nav>

<style>
    .menu-links {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
    }

    .menu-links section {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
    }

    .menu-links h2 {
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: var(--fw-normal);
        font-size: var(--fs-sm);
        color: var(--color-muted);
        text-transform: lowercase;
    }

    .menu-links ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }

    .menu-links li {
        list-style: none;
    }

    .menu-links a {
        font-family: var(--font-serif);
        font-size: var(--fs-xl);
        text-decoration: none;
        color: inherit;
    }

    .menu-links a:hover {
        text-decoration: underline;
        text-decoration-thickness: 1px;
    }
</style>
