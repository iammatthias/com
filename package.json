    "agent:check:live": "node scripts/agent-check.mjs --url https://iammatthias.com"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "@astrojs/react": "^6.0.0",
    "@astrojs/rss": "^4.0.19",
    "@ternlight/base": "^0.1.0",
    "astro": "^7.2.4",
    "graphql": "^17.0.2",
    "marked": "^18.0.5",
    "mermaid": "^11.16.0",
    "p-limit": "^7.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "viem": "^2.54.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "playwright": "^1.61.1"
