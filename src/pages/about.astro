---
export const prerender = true;

import BaseLayout from "@layouts/BaseLayout.astro";
import { AUTHOR, SOCIAL_LINKS } from "@lib/identity";
import type { MenuMeta } from "@lib/menu";

export const menu: MenuMeta = { group: "personal", label: "about", order: 1 };
---

<BaseLayout
    title="About"
    description="Matthias Jordan is a photographer and solutions engineer in Southern California. This is his personal archive."
    profilePage={true}
>
    <header class="page-header">
        <h1>About</h1>
    </header>

    <section class="prose">
        <section>
            <p>
                I'm Matthias Jordan. I'm a photographer and solutions engineer
                in Southern California. This site is my cozy corner of the web.
                It is an archive, not a portfolio. Nothing here is for sale.
            </p>
            <p>
                Photography comes first. I make long exposures of the ocean,
                aerial and drone work in California, Hawaii, and Baja, and
                snapshots with film cameras and my iPhone. I also make
                generative experiments trained on my own images. Some work is
                collected into series with process notes. Some is just a
                photograph and a date.
            </p>
            <p>
                For work, I'm a solutions engineer. I also build things for the
                web. That includes AT Protocol tools, Cloudflare Workers, small
                AI hardware projects, and Farfield. Farfield is the self-hosted,
                content-addressed backend serving this site. I write about what
                I build, including the parts that do not work.
            </p>
            <p>
                I cook, too. The recipes here are things I actually make. They
                use the tabular format from <em>Cooking for Engineers</em>, with
                ingredients on the left and each step running across the page.
            </p>
            <p>
                I want a web that's open and personal. I own my data, make
                handmade sites, and build in the open. There is no account to
                make and no newsletter to join. This is simply where I keep my
                work.
            </p>
        </section>

        <section>
            <h2>Elsewhere</h2>
            <ul>
                {SOCIAL_LINKS.filter((l) => !l.schemaOnly).map((l) => (
                    <li>
                        <a href={l.url} rel="me noopener">{l.name}</a><span>: {l.username}</span>
                    </li>
                ))}
            </ul>
        </section>

        <section>
            <h2>This site</h2>
            <p>
                Built with Astro on Cloudflare Workers, reading a self-hosted
                Farfield backend. Content is content-addressed, every page has a
                markdown twin, and the whole thing is open source.
                See <a href="/developers">developers</a> for the machine-readable
                surfaces, or <a href="/now">now</a> for what I'm up to lately.
            </p>
        </section>
    </section>
</BaseLayout>
