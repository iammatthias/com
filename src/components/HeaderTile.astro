---
import ColumnTile from "@components/ColumnTile.astro";
---

<span class="header-tile">
    <ColumnTile size={32} alt="iammatthias" />
</span>

<style>
    .header-tile {
        display: inline-block;
        width: 32px;
        height: 32px;
        background: var(--color-border);
        transform: rotate(45deg);
        transform-origin: center;
        overflow: hidden;
    }

    .header-tile :global(canvas) {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        user-select: none;
    }
</style>
