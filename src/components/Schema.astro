---
import type { BreadcrumbItem } from "./Breadcrumbs.astro";
import { AUTHOR, SOCIAL_LINKS } from "@lib/identity";

interface Props {
    siteOrigin: string;
    siteName: string;
    canonical: string;
    title: string;
    description: string;
    image?: string;
    breadcrumbs?: BreadcrumbItem[];
    article?: {
        publishedTime: string;
        modifiedTime?: string;
    };
    profilePage?: boolean;
    faq?: Array<{ question: string; answer: string }>;
}

const {
    siteOrigin,
    siteName,
    canonical,
    title,
    description,
    image,
    breadcrumbs = [],
    article,
    profilePage = false,
    faq = [],
} = Astro.props;

const origin = siteOrigin.replace(/\/$/, "");
const websiteId = `${origin}/#website`;
const personId = `${origin}/#person`;
const webpageId = `${canonical}#webpage`;
const isHomepage = canonical === `${origin}/`;

const graph: Record<string, unknown>[] = [
    {
        "@type": "WebSite",
        "@id": websiteId,
        url: `${origin}/`,
        name: siteName,
        publisher: { "@id": personId },
    },
    {
        "@type": "Person",
        "@id": personId,
        name: AUTHOR.name,
        alternateName: AUTHOR.alternateName,
        description: AUTHOR.description,
        knowsAbout: AUTHOR.knowsAbout,
        url: `${origin}/`,
        sameAs: SOCIAL_LINKS.map((l) => l.url),
    },
    {
        "@type": profilePage ? "ProfilePage" : "WebPage",
        "@id": webpageId,
        url: canonical,
        name: title,
        description,
        isPartOf: { "@id": websiteId },
        ...(isHomepage && { about: { "@id": personId } }),
        ...(profilePage && { mainEntity: { "@id": personId } }),
        ...(image && { image }),
        speakable: {
            "@type": "SpeakableSpecification",
            cssSelector: [".page-header h1", ".page-header p", ".intro", ".doc-hero"],
        },
        ...(article && {
            datePublished: article.publishedTime,
            ...(article.modifiedTime && {
                dateModified: article.modifiedTime,
            }),
        }),
    },
];

if (breadcrumbs.length > 0) {
    graph.push({
        "@type": "BreadcrumbList",
        "@id": `${canonical}#breadcrumbs`,
        itemListElement: [
            { "@type": "ListItem", position: 1, name: "home", item: `${origin}/` },
            ...breadcrumbs.map((crumb, i) => ({
                "@type": "ListItem",
                position: i + 2,
                name: crumb.label,
                ...(crumb.href && { item: `${origin}${crumb.href}` }),
            })),
        ],
    });
}

if (faq.length > 0) {
    graph.push({
        "@type": "FAQPage",
        "@id": `${canonical}#faq`,
        isPartOf: { "@id": webpageId },
        mainEntity: faq.map((f) => ({
            "@type": "Question",
            name: f.question,
            acceptedAnswer: { "@type": "Answer", text: f.answer },
        })),
    });
}

if (article) {
    graph.push({
        "@type": "BlogPosting",
        "@id": `${canonical}#article`,
        headline: title,
        description,
        url: canonical,
        mainEntityOfPage: { "@id": webpageId },
        author: { "@id": personId },
        publisher: { "@id": personId },
        datePublished: article.publishedTime,
        ...(article.modifiedTime && { dateModified: article.modifiedTime }),
        ...(image && { image }),
    });
}

const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });
---

<script type="application/ld+json" set:html={jsonLd} is:inline />
