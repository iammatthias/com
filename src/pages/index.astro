---
export const prerender = false;

import BaseLayout from "@layouts/BaseLayout.astro";
import FeedCard from "@components/FeedCard.astro";
import GlassArch from "@components/GlassArch.astro";
import CollectionPanel from "@components/CollectionPanel.astro";
import Deck from "@components/Deck.astro";
import { getLiveCollection } from "astro:content";
import { setResponseCacheHeaders } from "@lib/cache";
import { entriesOf, type DocumentData } from "@lib/farfield-loader";
import { builtDocFilter } from "@lib/content-query";
import { deckColumns } from "@lib/deck";
import { isPreview } from "@lib/preview";

const preview = isPreview(Astro);

const {
    entries: feedEntries,
    error: feedError,
    cacheHint,
} = await getLiveCollection("documents", { preview });

let feed: DocumentData[] = [];
if (feedError) {
    console.error("[index] Farfield feed fetch failed:", feedError);
} else {
    feed = entriesOf<DocumentData>(feedEntries).filter(
        await builtDocFilter(),
    );
}

const RECENT_LIMIT = 24;
const recent = feed.slice(0, RECENT_LIMIT);
const total = feed.length;
const columns = await deckColumns();

setResponseCacheHeaders(Astro.response, cacheHint);
---

<BaseLayout deck>
    <Deck columns={columns} label="recent" href="/content" count={String(total)}>
        <section class="home-hero">
            <GlassArch />
            <div class="home-intro">
                <h1>Hi, I am Matthias.</h1>
                <p>
                    This is my cozy corner on the web. A collection of
                    photographs, projects, recipes, and notes.
                </p>
            </div>
        </section>

        {recent.length > 0 && (
            <ul class="grid home-recent">
                {recent.map((item) => (
                    <FeedCard
                        href={item.href}
                        title={item.title}
                        description={item.description}
                        publishedAt={item.publishedAt}
                        kind={item.publication.name.toLowerCase()}
                        draft={item.published === false}
                    />
                ))}
            </ul>
        )}

        <section class="home-collections" aria-label="Collections">
            {columns.map((c) => <CollectionPanel column={c} />)}
        </section>
    </Deck>
</BaseLayout>

<style>
    .recent {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        width: 100%;
    }

    .recent h2 {
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: var(--fw-normal);
    }

    @media (min-width: 1200px) {
        .recent {
            display: none;
        }
    }

    @media (max-width: 480px) {
        .recent .grid > :global(li:nth-child(n + 7)) {
            display: none;
        }
    }
</style>
