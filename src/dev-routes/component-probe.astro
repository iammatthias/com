---
import { renderMarkdownBody } from "@lib/doc-render";
import { plainText } from "@lib/markdown-text";

export const prerender = false;

const A = "bafkreieoacno655ndfh42osocf7rsdigyk2fcqnrh2fb3fez5orx4heiae";
const B = "bafkreifhvx6mmxfgakknag57mjjf2iim2txesulyb7lhmshem6aeotqbni";

const body = `Prose before the component.

<ff-compare before="blob://${A}" after="blob://${B}" label-before="SOOC" label-after="Graded" />

Prose between components.

<ff-compare before="blob://${A}" after="blob://${B}" start="25" />

An unknown component:

<ff-not-deployed some="prop" />

A documented example inside a code fence, which must render as code
and not as a live component:

\`\`\`markdown
<ff-compare before="blob://cid" after="blob://cid" />
\`\`\`

And inline code: \`<ff-compare />\` should also stay literal.

Prose after everything.
`;

const html = await renderMarkdownBody(body);
const text = plainText(body);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex,nofollow" />
        <title>Component probe</title>
        <style is:inline>
            body {
                margin: 0 auto;
                padding: 2rem;
                max-width: 42rem;
                font-family: system-ui, sans-serif;
            }
            astro-dev-toolbar,
            astro-dev-overlay {
                display: none !important;
            }
            :root {
                --space-1: 0.25rem; --space-2: 0.5rem; --space-3: 0.75rem;
                --space-5: 1.5rem; --radius: 6px;
                --color-muted: #6b6b6b; --color-border: #ddd8cc;
                --color-fg: #1a1a1a; --fs-xs: 0.75rem; --fs-sm: 0.875rem;
                --lh-normal: 1.5;
                --font-mono: ui-monospace, monospace;
            }
            ff-compare { display: block; margin: var(--space-5) 0; }
            .ff-compare-frame {
                position: relative; margin: 0; overflow: hidden;
                border-radius: var(--radius); line-height: 0;
                touch-action: pan-y;
            }
            .ff-compare-layer { top: 0; left: 0; width: 100%; }
            .ff-compare-after { position: relative; }
            .ff-compare-before {
                position: absolute; height: 100%;
                clip-path: inset(0 calc(100% - var(--ff-compare-pos, 50%)) 0 0);
            }
            .ff-compare-img { display: block; width: 100%; height: auto; }
            .ff-compare-label {
                position: absolute; bottom: var(--space-2);
                padding: 0.15em 0.5em; border-radius: 3px;
                font-family: var(--font-mono); font-size: var(--fs-xs);
                text-transform: uppercase; letter-spacing: 0.08em;
                background: rgb(0 0 0 / 0.55); color: rgb(255 255 255 / 0.92);
            }
            .ff-compare-label-before { left: var(--space-2); }
            .ff-compare-label-after { right: var(--space-2); }
            .ff-compare-handle {
                position: absolute; top: 0; bottom: 0;
                left: var(--ff-compare-pos, 50%); width: 2px;
                margin-left: -1px; background: rgb(255 255 255 / 0.85);
                box-shadow: 0 0 0 1px rgb(0 0 0 / 0.25); pointer-events: none;
            }
            .ff-compare-control {
                display: flex; flex-direction: column; gap: var(--space-1);
                margin-top: var(--space-2);
            }
            .ff-compare-control-label {
                font-family: var(--font-mono); font-size: var(--fs-xs);
                color: var(--color-muted);
            }
            .ff-compare-range { width: 100%; accent-color: var(--color-fg); }
            ff-compare.is-interactive .ff-compare-frame { cursor: ew-resize; }
            .ff-component-missing {
                padding: var(--space-2) var(--space-3);
                border-left: 2px solid var(--color-border);
                font-family: var(--font-mono); font-size: var(--fs-sm);
                color: var(--color-muted);
            }
            .probe-text {
                font-family: ui-monospace, monospace;
                font-size: 0.8rem;
                background: #f4f2ec;
                padding: 0.75rem;
                white-space: pre-wrap;
            }
        </style>
    </head>
    <body>
        <h1>Component probe</h1>
        <div class="doc-body" set:html={html} />
        <h2>plainText() output</h2>
        <p class="probe-text">{text}</p>
        <script>
            import { mountDocComponents } from "@src/scripts/doc-components";
            mountDocComponents();
        </script>
    </body>
</html>
