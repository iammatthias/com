---
import { fmtDate } from "@lib/format";
import type { DeckColumnModel } from "@lib/deck";

interface Props {
    column: DeckColumnModel;
}

const { column } = Astro.props;
---

<section
    class="deck-col deck-col--peek"
    data-deck-col={column.id}
    aria-labelledby={`deck-head-${column.id}`}
>
    <header class="deck-col__head">
        <h2 class="deck-col__title" id={`deck-head-${column.id}`}>
            <a href={column.href}>{column.label}</a>
        </h2>
        <span class="deck-col__tools">
            {column.total > 0 && (
                <span class="deck-col__count">{column.total}</span>
            )}
            <button
                type="button"
                class="deck-col__close"
                data-deck-close={column.id}
                aria-label={`Close ${column.label} column`}
                title={`Close ${column.label}`}
            >×</button>
        </span>
    </header>

    <div class="deck-col__body" data-deck-scroll={column.id}>
        <ul class="deck-peek">
            {column.peek.map((item) => (
                <li>
                    <a href={item.href}>
                        <span class="deck-peek__title">{item.title}</span>
                        {item.date && (
                            <time class="deck-peek__date" datetime={item.date}>
                                {fmtDate(item.date)}
                            </time>
                        )}
                    </a>
                </li>
            ))}
        </ul>
        {column.total > column.peek.length && (
            <a class="deck-all" href={column.href}>
                all {column.total} →
            </a>
        )}
    </div>
</section>
