---
interface Props {
    size?: number;
    alt?: string;
}

const { size = 22, alt = "" } = Astro.props;
---

<span
    class="column-tile"
    data-azulejo-tile
    data-azulejo-size={String(size)}
    data-azulejo-alt={alt || undefined}
    style={`--tile: ${size}px`}
    aria-hidden={alt ? undefined : "true"}
></span>
