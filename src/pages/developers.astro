---
export const prerender = true;

import BaseLayout from "@layouts/BaseLayout.astro";
import { CONTENT_SIGNAL, EXAMPLE_DOC_PATH, API_OPERATIONS, AGENT_SKILLS, AGENT_RESOURCES, SITE_ORIGIN } from "@lib/agent-surface";
import type { MenuMeta } from "@lib/menu";

export const menu: MenuMeta = { group: "other", label: "developers", order: 3 };

const faq = [
    {
        question: "Does the iammatthias.com API require authentication?",
        answer: "No. Every endpoint, feed, and MCP tool is public and anonymous. Do not send an Authorization header; it is ignored.",
    },
    {
        question: "What does the iammatthias.com API cost?",
        answer: "Nothing. There is no account, no API key, and no paid tier. Rate limits are Cloudflare's edge defaults.",
    },
    {
        question: "Does iammatthias.com have an MCP server?",
        answer: `Yes, at https://iammatthias.com/mcp over Streamable HTTP with no authentication. It exposes ${AGENT_SKILLS.map((s) => s.name).join(", ")}.`,
    },
    {
        question: "How do I get a page from iammatthias.com as markdown?",
        answer: "Append .md to any content URL. The whole corpus is available in one request at https://iammatthias.com/llms-full.txt.",
    },
    {
        question: "Can I use content from iammatthias.com for AI training?",
        answer: `No. The site's Content-Signal policy is ${CONTENT_SIGNAL}. Quoting with attribution and a link to the canonical URL is welcome.`,
    },
];
---

<BaseLayout
    title="iammatthias.com developer documentation: API, GraphQL & MCP"
    description="JSON endpoints, an MCP server, markdown twins, and the full iammatthias.com corpus in one file. Public, free, and no key required."
    markdownHref="/developers.md"
    faq={faq}
>
    <header class="page-header">
        <h1>iammatthias.com developer documentation</h1>
        <p>
            This site makes its content available in machine-readable form. It
            is public and free. There is no account, API key, or paid tier.
        </p>
        <p class="meta"><a href="/developers.md">this page as markdown</a></p>
    </header>

    <section class="prose">
        <section>
            <h2>Quickstart</h2>
            <pre><code>{`# Search the site
curl "${SITE_ORIGIN}/api/search.json?q=cloudflare+workers"

# List one section
curl "${SITE_ORIGIN}/api/content.json?section=recipes"

# Read a document as markdown
curl "${SITE_ORIGIN}/${EXAMPLE_DOC_PATH}.md"

# The whole corpus in one request
curl "${SITE_ORIGIN}/llms-full.txt"`}</code></pre>
        </section>

        <section>
            <h2>HTTP endpoints</h2>
            <dl>
                {API_OPERATIONS.map((op) => (
                    <>
                        <dt><code>GET {op.path}</code></dt>
                        <dd>{op.description}</dd>
                    </>
                ))}
            </dl>
            <p>
                The full specification is at <a href="/openapi.json">openapi.json</a>.
                Errors are RFC 9457 problem documents. Each one has
                a <code>resolution</code> field that says how to retry.
            </p>
        </section>

        <section>
            <h2>MCP server</h2>
            <p>
                The MCP server uses Streamable HTTP at <code>{SITE_ORIGIN}/mcp</code>.
                It does not require authentication. Add it to any MCP client:
            </p>
            <pre><code>{`{ "mcpServers": { "iammatthias": { "url": "${SITE_ORIGIN}/mcp" } } }`}</code></pre>
            <ul>
                {AGENT_SKILLS.map((s) => (
                    <li><code>{s.name}</code>: {s.description}</li>
                ))}
            </ul>
            <p>
                Preview the tools without connecting: <a href="/.well-known/mcp/server-card.json">server-card.json</a>.
            </p>
        </section>

        <section>
            <h2>Markdown twins</h2>
            <p>
                Every content URL has a markdown twin at the same path plus <code>.md</code>.
                It includes front matter with the title, dates, tags, content
                hash, and canonical URL. Images resolve to public URLs. Section
                indexes are at <code>/&lt;section&gt;.md</code>. Each section has
                scoped context at <code>/&lt;section&gt;/llms.txt</code>.
            </p>
        </section>

        <section>
            <h2>Everything else</h2>
            <ul>
                {AGENT_RESOURCES.map((r) => (
                    <li><a href={r.url}>{r.name}</a>: {r.description}</li>
                ))}
            </ul>
        </section>

        <section>
            <h2>Caching and etiquette</h2>
            <p>
                Every record has a <code>cid</code>, which is a CIDv1 content
                hash. The same cid means the same bytes, forever. Cache against
                it instead of fetching the record again.
                Prefer <a href="/llms-full.txt">llms-full.txt</a> to crawling
                page by page. Send a descriptive <code>User-Agent</code>.
                The source is at <a href="https://github.com/iammatthias/com">github.com/iammatthias/com</a>.
            </p>
        </section>
    </section>
</BaseLayout>
