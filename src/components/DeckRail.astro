---
import GlassArch from "@components/GlassArch.astro";
import ColumnTile from "@components/ColumnTile.astro";
import type { DeckColumnModel } from "@lib/deck";
import { getMenuGroups } from "@lib/site-menu";
import { SITE_IDENTITY } from "@lib/agent-surface";

interface Props {
    columns: DeckColumnModel[];
    current?: string;
    home?: boolean;
}

const { columns, current, home = false } = Astro.props;

const siteGroups = (await getMenuGroups()).filter(
    (g) => g.label && g.label !== "publications",
);
---

<aside
    class:list={["deck-col", "deck-col--rail", { "deck-col--rail-home": home }]}
    data-deck-col="rail"
    aria-label="Site navigation"
>
    <div class="deck-col__body" data-deck-scroll="rail">
        {home ? (
            <section class="cover">
                <GlassArch />
                <section class="intro" aria-label="Introduction">
                    <h1 class="greeting">Hi, I am Matthias.</h1>
                    <p>
                        This is my cozy corner on the web. A collection of
                        photographs, projects, recipes, and notes.
                    </p>
                </section>
            </section>
        ) : (
            <div class="rail-brand">
                <ColumnTile live size={32} alt={SITE_IDENTITY.title} />
                <a href="/" class="rail-identity">{SITE_IDENTITY.title}</a>
            </div>
        )}

        <nav class="rail-nav" aria-label="Sections">
            <ul class="rail-list rail-list--collections">
                {columns.map((c) => (
                    <li>
                        <a
                            href={c.href}
                            aria-current={c.id === current ? "page" : undefined}
                        >
                            <span class="rail-name">{c.label}</span>
                            <span class="rail-count">{c.total}</span>
                        </a>
                        <button
                            type="button"
                            class="rail-toggle"
                            data-deck-toggle={c.id}
                            aria-pressed="true"
                            aria-label={`Hide ${c.label} column`}
                            hidden={c.id === current}
                        >×</button>
                    </li>
                ))}
            </ul>
        </nav>

        <nav class="rail-nav rail-nav--site" aria-label="Site">
            {siteGroups.map((group) => (
                <ul class="rail-list">
                    {group.links.map((l) => (
                        <li>
                            <a
                                href={l.href}
                                aria-current={
                                    Astro.url.pathname === l.href ? "page" : undefined
                                }
                            >{l.label}</a>
                        </li>
                    ))}
                </ul>
            ))}
        </nav>

        <div class="rail-tools">
            <a href="/menu" data-menu-trigger>menu</a>
        </div>

        <slot />
    </div>
</aside>

<style>
    .cover {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--space-4);
        width: 100%;
    }

    .intro {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        width: 100%;
        max-width: 60ch;
    }

    .intro .greeting {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: var(--fs-2xl);
        font-weight: var(--fw-normal);
        line-height: var(--lh-tight);
    }

    .intro p {
        font-size: var(--fs-base);
        line-height: var(--lh-relaxed);
        text-wrap: pretty;
    }
</style>
