---
export const prerender = false;

import BaseLayout from "@layouts/BaseLayout.astro";
import GlassArch from "@components/GlassArch.astro";
import CollectionPanel from "@components/CollectionPanel.astro";
import FeedEntryCard from "@components/FeedEntryCard.astro";
import { getLiveCollection } from "astro:content";
import { setResponseCacheHeaders } from "@lib/cache";
import { deckColumns } from "@lib/deck";
import {
    entriesOf,
    resolveBodyMedia,
    type FeedEntryData,
    type ResolvedMedia,
} from "@lib/farfield-loader";
import { isPreview } from "@lib/preview";
import { glassPick } from "@lib/glass";

const preview = isPreview(Astro);

const [collections, pick, feed] = await Promise.all([
    deckColumns(),
    Promise.race([
        glassPick(),
        new Promise<null>((resolve) => setTimeout(() => resolve(null), 1000)),
    ]),
    getLiveCollection("feedEntries"),
]);

const FEED_ITEMS = 3;
const { entries: rawFeed, error: feedError, cacheHint } = feed;
if (feedError) {
    console.error("[/] Farfield feed entries fetch failed:", feedError);
}
const allFeed: FeedEntryData[] = entriesOf<FeedEntryData>(rawFeed);
const feedItems = allFeed.slice(0, FEED_ITEMS);
const feedMedia = new Map<string, ResolvedMedia[]>(
    await Promise.all(
        feedItems.map(
            async (it) => [it.rkey, await resolveBodyMedia(it.body)] as const,
        ),
    ),
);

setResponseCacheHeaders(Astro.response, cacheHint);
---

<BaseLayout deck="home">
    <div class="home">
        <section class="home-static" aria-label="Introduction">
            <GlassArch pick={pick} />
            <div class="home-intro">
                <h1>Hi, I am Matthias.</h1>
                <p>
                    This is my cozy corner on the web. A collection of
                    photographs, projects, recipes, and notes.
                </p>
            </div>
        </section>

        {feedItems.length > 0 && (
            <section class="home-feed" aria-labelledby="home-feed-heading">
                <h2 class="home-col__head" id="home-feed-heading">
                    <a href="/feed">feed</a>
                    <span class="home-col__count">{allFeed.length}</span>
                </h2>
                <ul class="feed">
                    {feedItems.map((item) => (
                        <FeedEntryCard
                            item={item}
                            media={feedMedia.get(item.rkey) ?? []}
                        />
                    ))}
                </ul>
                <a class="deck-all" href="/feed">all {allFeed.length} →</a>
            </section>
        )}

        <section class="home-lists" aria-label="Collections">
            {collections.map((c) => <CollectionPanel column={c} />)}
        </section>
    </div>
</BaseLayout>

<style>
    .recent {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        width: 100%;
    }

    .recent h2 {
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: var(--fw-normal);
    }

    @media (min-width: 1200px) {
        .recent {
            display: none;
        }
    }

    @media (max-width: 480px) {
        .recent .grid > :global(li:nth-child(n + 7)) {
            display: none;
        }
    }
</style>
