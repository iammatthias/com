---
export const prerender = true;

import BaseLayout from "@layouts/BaseLayout.astro";
import DocArticle from "@components/DocArticle.astro";
import Deck from "@components/Deck.astro";
import { getCollection } from "astro:content";
import { renderKey, type DocumentData } from "@lib/farfield-loader";
import { plainText } from "@lib/markdown-text";
import { relatedDocs } from "@lib/content-query";
import { pageCacheKey } from "@lib/layout-fingerprint";

export async function getStaticPaths() {
    const all = (await getCollection("docs")).map(
        (e) => e.data as DocumentData,
    );
    return all.map((item) => {
        const related = relatedDocs(item, all);
        return {
            params: { publication: item.collection, slug: item.rkey },
            props: { item, related },
            cacheKey: pageCacheKey([item, ...related].map(renderKey).join(":")),
        };
    });
}

const { item, related } = Astro.props as {
    item: DocumentData;
    related: DocumentData[];
};

const metaDescription =
    item.description || plainText(item.body).slice(0, 180).trim();

const markdownPath = `${item.href}.md`;

---

<BaseLayout
    deck
    title={item.title}
    description={metaDescription}
    ogImage={`/${item.publication.slug}/${encodeURIComponent(item.title)}`}
    ogType="article"
    article={{
        publishedTime: item.publishedAt,
        modifiedTime: item.updatedAt,
    }}
    breadcrumbs={[
        {
            label: item.publication.name.toLowerCase(),
            href: `/${item.publication.slug}`,
        },
    ]}
    markdownHref={markdownPath}
>
    <Deck current={item.collection} raw>
        <DocArticle item={item} related={related} deck />
    </Deck>
</BaseLayout>
