---
export const prerender = false;

const { seed: rawSeed } = Astro.params;
const seed = rawSeed ? Number.parseInt(rawSeed, 10) : Date.now();
const safeSeed = Number.isFinite(seed) ? seed : Date.now();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="robots" content="noindex,nofollow" />
        <title>Azulejo {safeSeed}</title>
        <style is:inline>
            html,
            body {
                margin: 0;
                padding: 0;
                background: transparent;
            }
            #tile {
                position: fixed;
                top: 0;
                left: 0;
            }
            astro-dev-toolbar,
            astro-dev-overlay {
                display: none !important;
            }
        </style>
    </head>
    <body>
        <div id="tile" data-seed={safeSeed}></div>
        <script>
            import { mountAzulejoTile } from "@src/scripts/azulejo-tile";
            const el = document.getElementById("tile")!;
            mountAzulejoTile(el, {
                seed: Number(el.dataset.seed),
                size: 256,
            });
        </script>
    </body>
</html>
