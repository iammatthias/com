---
import { tilePreset } from "@lib/images";
import { blobURL, type ResolvedMedia } from "@lib/farfield-loader";
import { wsrvUrl, wsrvSrcSet } from "@lib/farfield";

interface Props {
    media: ResolvedMedia[];
    loading?: "lazy" | "eager";
}

const { media, loading = "lazy" } = Astro.props;

const preset = tilePreset(media.length > 1);
const fallbackW = preset.widths[Math.floor(preset.widths.length / 2)] ?? 720;
const count = Math.min(media.length, 4);

const TALLEST = 0.8;
const WIDEST = 16 / 9;
const soloRatio = (m: ResolvedMedia): number | null => {
    const w = m.meta?.width;
    const h = m.meta?.height;
    if (!w || !h) return null;
    return Math.min(WIDEST, Math.max(TALLEST, w / h));
};
---

{media.length > 0 && (
    <div
        class:list={["feed-media", `feed-media--${count}`]}
        data-count={media.length}
    >
        {media.map((m) => {
            const src = blobURL(m.cid);
            const mime = m.meta?.mime ?? "";
            if (mime.startsWith("video/")) {
                return (
                    <figure class="feed-tile feed-tile--video">
                        <video
                            controls
                            preload="metadata"
                            playsinline
                            src={src}
                            aria-label={m.alt || undefined}
                        />
                    </figure>
                );
            }
            if (mime.startsWith("audio/")) {
                return (
                    <figure class="feed-tile feed-tile--audio">
                        <audio
                            controls
                            preload="metadata"
                            src={src}
                            aria-label={m.alt || undefined}
                        />
                    </figure>
                );
            }
            return (
                <figure
                    class="feed-tile"
                    style={[
                        m.meta?.dominantColor && `background:${m.meta.dominantColor}`,
                        count === 1 && soloRatio(m) && `aspect-ratio:${soloRatio(m)}`,
                    ].filter(Boolean).join(";") || undefined}
                >
                    <img
                        src={wsrvUrl(src, fallbackW)}
                        srcset={wsrvSrcSet(src, preset.widths)}
                        sizes={preset.sizes}
                        width={m.meta?.width ?? 960}
                        height={m.meta?.height ?? 720}
                        alt={m.alt ?? ""}
                        loading={loading}
                        decoding="async"
                    />
                </figure>
            );
        })}
    </div>
)}
