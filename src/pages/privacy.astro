---
export const prerender = true;

import BaseLayout from "@layouts/BaseLayout.astro";
import { SITE_IDENTITY } from "@lib/agent-surface";
import type { MenuMeta } from "@lib/menu";

export const menu: MenuMeta = { group: "other", label: "privacy", order: 4 };
---

<BaseLayout
    title="Privacy"
    description="Privacy at iammatthias.com. No cookies, analytics, tracking, or accounts."
>
    <header class="page-header">
        <h1>Privacy</h1>
    </header>

    <section class="prose">
        <section>
            <h2>The short version</h2>
            <p>
                This site has no cookies, analytics, tracking pixels, or
                accounts. There is no consent banner because there is nothing
                to consent to.
            </p>
        </section>

        <section>
            <h2>What is logged</h2>
            <p>
                The site runs on Cloudflare Workers. Cloudflare keeps standard
                request logs as part of serving and protecting it. These include
                your IP address, user agent, requested URL, response status, and
                timing. I use the logs to debug problems and check that automated
                clients can reach the content. Cloudflare retains them on its
                default schedule. I do not export, sell, or combine them with
                anything else.
            </p>
            <p>
                Images come through wsrv.nl, an image-resizing proxy, and
                blobs.farfield.systems, my own server. Your browser contacts
                those hosts when it loads an image. They see the same basic
                request metadata.
            </p>
        </section>

        <section>
            <h2>What runs in your browser</h2>
            <p>
                Search is the only substantial script. It downloads a small
                model and finds matches on your device. Your queries are not
                sent anywhere. The results are cached in your browser's storage
                and stay there.
            </p>
            <p>
                The onchain analytics portrait reads a public testnet contract
                from your browser when you visit that page. It does not ask for
                a wallet connection or write anything.
            </p>
        </section>

        <section>
            <h2>Your data</h2>
            <p>
                There is no account data because there are no accounts. If you
                email me, I keep the message in my mailbox like any other
                correspondence. I will not add you to anything. Ask me to delete
                it and I will.
            </p>
        </section>

        <section>
            <h2>Content</h2>
            <p>
                The writing, photographs, and generative work are © Matthias
                Jordan, all rights reserved. You are welcome to quote them with
                attribution and a link. Ask before republishing a whole work.
            </p>
            <p>
                Questions: <a href={`mailto:${SITE_IDENTITY.email}`}>{SITE_IDENTITY.email}</a>
            </p>
        </section>
    </section>
</BaseLayout>
