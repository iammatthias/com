---
export const prerender = false;

import BaseLayout from "@layouts/BaseLayout.astro";
import Deck from "@components/Deck.astro";
import FeedCard from "@components/FeedCard.astro";
import Pagination from "@components/Pagination.astro";
import { getPage, parsePageParam } from "@lib/pagination";
import { sectionForRoute } from "@lib/content-query";
import { setDocumentPageCacheHeaders } from "@lib/cache";

const page = parsePageParam(Astro.params.page);
const section = await sectionForRoute(Astro.params.publication);
if (page === null || !section) return new Response(null, { status: 404 });
const { pub, items } = section;

const base = `/${pub.slug}`;
const paged = getPage(items, page, base);
if (!paged) return new Response(null, { status: 404 });
setDocumentPageCacheHeaders(Astro.response);

---

<BaseLayout
    deck
    title={page > 1 ? `${pub.name} — page ${page}` : pub.name}
    description={pub.description ?? `${pub.name} — iammatthias`}
    ogImage={`/${pub.slug}`}
    markdownHref={`/${pub.slug}.md`}
    pagination={{ prev: paged.prevHref, next: paged.nextHref }}
>
    <Deck current={pub.slug}>
    <header class="page-header">
        <h1>{pub.name}</h1>
        {pub.description && <p>{pub.description}</p>}
        <p class="meta">
            <a href={`/${pub.slug}/rss.xml`}>RSS</a>
            <span> · </span>
            <span>{paged.total} {paged.total === 1 ? "entry" : "entries"}</span>
        </p>
    </header>

    {paged.total === 0 ? (
        <p class="feed-empty">No entries published yet.</p>
    ) : (
        <>
            <ul class="grid">
                {paged.items.map((item) => (
                    <FeedCard
                        href={item.href}
                        title={item.title}
                        description={item.description}
                        publishedAt={item.publishedAt}
                        draft={item.published === false}
                    />
                ))}
            </ul>
            <Pagination
                page={paged.page}
                totalPages={paged.totalPages}
                basePath={base}
            />
        </>
    )}
    </Deck>
</BaseLayout>
