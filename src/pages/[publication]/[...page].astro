---
// Per-publication index, prerendered. Single `[...page]` catch-all
// serves both `/<pub>` (page 1, param undefined) and `/<pub>/page/N`.
// Sibling routes win by Astro's route priority: `[slug].astro` (a
// named param) outranks this rest route for `/<pub>/<slug>`, and
// `rss.xml.ts` (static) for `/<pub>/rss.xml`. cacheKey folds the
// member cids, so a list page re-renders only when its slice of the
// publication actually changes.
export const prerender = true;

import { createHash } from "node:crypto";
import BaseLayout from "@layouts/BaseLayout.astro";
import FeedCard from "@components/FeedCard.astro";
import Pagination from "@components/Pagination.astro";
import { getCollection } from "astro:content";
import { getPage, PAGE_SIZE } from "@lib/pagination";
import type { DocumentData, PublicationData } from "@lib/farfield-loader";

export async function getStaticPaths() {
    const pubs = (await getCollection("pubs")).map(
        (e) => e.data as PublicationData,
    );
    const docs = (await getCollection("docs")).map(
        (e) => e.data as DocumentData,
    );
    const paths = [];
    for (const pub of pubs) {
        const items = docs
            .filter((d) => d.collection === pub.slug && d.published !== false)
            .sort((a, b) => b.publishedAt.localeCompare(a.publishedAt));
        const totalPages = Math.max(1, Math.ceil(items.length / PAGE_SIZE));
        for (let page = 1; page <= totalPages; page++) {
            const slice = items.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
            paths.push({
                params: {
                    publication: pub.slug,
                    page: page === 1 ? undefined : `page/${page}`,
                },
                props: { pub, items, page },
                cacheKey: createHash("sha1")
                    .update(
                        `${page}/${totalPages}:${slice.map((d) => d.cid).join(",")}`,
                    )
                    .digest("hex"),
            });
        }
    }
    return paths;
}

const { pub, items, page } = Astro.props as {
    pub: PublicationData;
    items: DocumentData[];
    page: number;
};

const base = `/${pub.slug}`;
const paged = getPage(items, page, base)!;
---

<BaseLayout
    title={page > 1 ? `${pub.name} — page ${page}` : pub.name}
    description={pub.description ?? `${pub.name} — iammatthias`}
    ogImage={`/${pub.slug}`}
    markdownHref={`/${pub.slug}.md`}
    pagination={{ prev: paged.prevHref, next: paged.nextHref }}
>
    <header class="page-header">
        <h1>{pub.name}</h1>
        {pub.description && <p>{pub.description}</p>}
        <p class="meta">
            <a href={`/${pub.slug}/rss.xml`}>RSS</a>
            <span> · </span>
            <span>{paged.total} {paged.total === 1 ? "entry" : "entries"}</span>
        </p>
    </header>

    {paged.total === 0 ? (
        <p class="feed-empty">No entries published yet.</p>
    ) : (
        <>
            <ul class="feed-grid">
                {paged.items.map((item) => (
                    <FeedCard
                        href={item.href}
                        title={item.title}
                        description={item.description}
                        publishedAt={item.publishedAt}
                        draft={item.published === false}
                    />
                ))}
            </ul>
            <Pagination
                page={paged.page}
                totalPages={paged.totalPages}
                basePath={base}
            />
        </>
    )}
</BaseLayout>
