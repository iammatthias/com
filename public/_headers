# Security headers for static-asset responses (prerendered pages,
# fonts, images). Cloudflare's _headers file only applies to assets —
# SSR responses get the same set from src/middleware.ts. The adapter
# appends its immutable /_astro/* cache rule to this file at build.
#
# The Content-Security-Policy is a copy of the one in
# src/middleware.ts — keep the two in sync (see the comment there for
# what each allowance is for). The prerendered onchain-analytics page
# is why connect-src carries the Base Sepolia RPC.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://wsrv.nl https://blobs.farfield.systems; media-src 'self' https://blobs.farfield.systems; connect-src 'self' https://sepolia.base.org; font-src 'self'; worker-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# llms.txt discovery pointer. Since the incremental-static move most
# content pages are assets and never reach the middleware, so the
# header rides every asset response from here (the ~55 bytes on
# images/fonts are the cost of not maintaining a per-section list of
# dynamic publication paths). SSR responses still get it from
# src/middleware.ts.
# RFC 8288 Link headers advertise the machine-readable surfaces on
# every response, so an agent learns them from any page it lands on
# without fetching the homepage first.
/*
  Link: </llms.txt>; rel="describedby"; type="text/markdown", </index.md>; rel="alternate"; type="text/markdown", </sitemap.xml>; rel="sitemap"; type="application/xml", </openapi.json>; rel="service-desc"; type="application/json", </.well-known/api-catalog>; rel="api-catalog", </rss.xml>; rel="alternate"; type="application/rss+xml"

# Markdown twins are a distinct representation of the same resource as
# their HTML page, so caches must key them separately (acceptmarkdown.com).
# Static assets bypass the middleware that used to set this.
/*.md
  Vary: Accept
  Content-Type: text/markdown; charset=utf-8

# llms.txt files are markdown by convention (llmstxt.org); the asset
# layer would otherwise serve them as text/plain on the .txt extension.
/llms.txt
  Vary: Accept
  Content-Type: text/markdown; charset=utf-8
/llms-full.txt
  Vary: Accept
  Content-Type: text/markdown; charset=utf-8
/*/llms.txt
  Vary: Accept
  Content-Type: text/markdown; charset=utf-8

# Extensionless .well-known documents. These endpoints are prerendered,
# and headers set inside a prerendered handler are discarded at build —
# the asset layer serves the bare file, and it cannot infer a media
# type without an extension. Without these rules both shipped with no
# Content-Type at all (RFC 9727 requires the linkset profile type).
/.well-known/api-catalog
  Content-Type: application/linkset+json;profile="https://www.rfc-editor.org/info/rfc9727"
  Cache-Control: public, max-age=3600
/.well-known/oauth-protected-resource
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

# Prebuilt search vectors: immutable per deploy, ~230 KB. A short
# browser cache skips the 304 revalidation on every visit; a stale
# copy after a deploy is harmless — the model/dims guard plus the
# IndexedDB layer absorb any drift, exactly as they do for content
# published between builds.
/api/search-vectors.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
