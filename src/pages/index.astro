---
export const prerender = false;

import BaseLayout from "@layouts/BaseLayout.astro";
import GlassArch from "@components/GlassArch.astro";
import CollectionPanel from "@components/CollectionPanel.astro";
import FeedEntryCard from "@components/FeedEntryCard.astro";
import { setResponseCacheHeaders } from "@lib/cache";
import { deckColumns } from "@lib/deck";
import { isPreview } from "@lib/preview";

const preview = isPreview(Astro);

const columns = await deckColumns();
const feedColumn = columns.find((c) => c.id === "feed");
const collections = columns.filter((c) => c.id !== "feed");

setResponseCacheHeaders(Astro.response);
---

<BaseLayout deck="home">
    <div class="home">
        <section class="home-static" aria-label="Introduction">
            <GlassArch />
            <div class="home-intro">
                <h1>Hi, I am Matthias.</h1>
                <p>
                    This is my cozy corner on the web. A collection of
                    photographs, projects, recipes, and notes.
                </p>
            </div>
        </section>

        {feedColumn && (
            <section class="home-feed" aria-labelledby="home-feed-heading">
                <h2 class="home-col__head" id="home-feed-heading">
                    <a href="/feed">feed</a>
                    <span class="home-col__count">{feedColumn.total}</span>
                </h2>
                <ul class="feed">
                    {feedColumn.feed?.map(({ item, media }) => (
                        <FeedEntryCard item={item} media={media} />
                    ))}
                </ul>
                <a class="deck-all" href="/feed">all {feedColumn.total} →</a>
            </section>
        )}

        <section class="home-lists" aria-label="Collections">
            {collections.map((c) => <CollectionPanel column={c} />)}
        </section>
    </div>
</BaseLayout>

<style>
    .recent {
        display: flex;
        flex-direction: column;
        gap: var(--space-6);
        width: 100%;
    }

    .recent h2 {
        font-family: var(--font-serif);
        font-style: italic;
        font-weight: var(--fw-normal);
    }

    @media (min-width: 1200px) {
        .recent {
            display: none;
        }
    }

    @media (max-width: 480px) {
        .recent .grid > :global(li:nth-child(n + 7)) {
            display: none;
        }
    }
</style>
