{
  "name": "iammatthias-com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/build-diagrams.mjs && astro dev",
    "build": "rm -rf dist .astro && node scripts/build-diagrams.mjs && bun test && astro build && node scripts/agent-check.mjs",
    "build:force": "rm -rf dist .astro node_modules/.astro && node scripts/build-diagrams.mjs && bun test && astro build --force && node scripts/agent-check.mjs",
    "preview": "astro preview",
    "smoke": "node scripts/smoke.mjs",
    "overflow": "node scripts/overflow-check.mjs",
    "diagram:retry": "node scripts/diagram-retry-check.mjs",
    "perf": "node scripts/perf-check.mjs",
    "perf:budget": "node scripts/perf-check.mjs --write",
    "astro": "astro",
    "snapshot:azulejos": "node scripts/snapshot-azulejos.mjs",
    "agent:check": "node scripts/agent-check.mjs",
    "agent:check:live": "node scripts/agent-check.mjs --url https://iammatthias.com",
    "test": "bun test",
    "art:verify": "node scripts/art-verify.mjs",
    "art:golden": "node scripts/art-verify.mjs --write"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/rss": "^4.0.19",
    "@ternlight/base": "^0.1.1",
    "astro": "^7.3.5",
    "graphql": "^17.0.2",
    "marked": "^18.0.14",
    "p-limit": "^7.3.3",
    "pele": "^1.7.0",
    "viem": "^2.56.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "^1.63.0"
  }
}
