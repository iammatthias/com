---
// All-content index, pages 2+, prerendered. Page 1 is /content
// (content/index.astro). Both render through ContentIndex.astro with
// data from @lib/content-index. cacheKey folds each page's member
// cids so unchanged pages skip on incremental builds.
export const prerender = true;

import ContentIndex from "@components/ContentIndex.astro";
import { loadContentIndex } from "@lib/content-index";
import { paginationCacheKey, getPage, PAGE_SIZE } from "@lib/pagination";
import type { ContentIndexData } from "@lib/content-index";

export async function getStaticPaths() {
    const data = await loadContentIndex();
    const totalPages = Math.max(
        1,
        Math.ceil(data.items.length / PAGE_SIZE),
    );
    const paths = [];
    for (let page = 2; page <= totalPages; page++) {
        const slice = data.items.slice(
            (page - 1) * PAGE_SIZE,
            page * PAGE_SIZE,
        );
        paths.push({
            params: { page: String(page) },
            props: { data, page },
            cacheKey: paginationCacheKey(page, totalPages, slice.map((d) => d.cid)),
        });
    }
    return paths;
}

const { data, page } = Astro.props as {
    data: ContentIndexData;
    page: number;
};

const paged = getPage(data.items, page, "/content")!;
---

<ContentIndex paged={paged} pubs={data.pubs} />
