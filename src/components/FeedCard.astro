---
import { fmtDate } from "@lib/format";

interface Props {
    href: string;
    title: string;
    description?: string;
    publishedAt: string;
    kind?: string;
    draft?: boolean;
}

const { href, title, description, publishedAt, kind, draft } = Astro.props;
---

<li class:list={["card", { "card--draft": draft }]}>
    <a href={href} class="card-link">
        {kind && <span class="card-kind">{kind}</span>}
        <h3>{title}</h3>
        {description && <p>{description}</p>}
        <time class="card-date" datetime={publishedAt}>{fmtDate(publishedAt)}</time>
    </a>
</li>

<style>
    .card--draft {
        outline: 1px dashed var(--color-muted);
        outline-offset: 2px;
        border-radius: var(--radius);
    }

    .card--draft .card-link::before {
        content: "Draft";
        align-self: flex-start;
        margin-bottom: var(--space-2);
        padding: 0.1em 0.5em;
        border-radius: 999px;
        background: var(--color-fg);
        color: var(--color-bg);
        font-family: var(--font-mono);
        font-size: var(--fs-xs);
        letter-spacing: 0.03em;
    }
</style>
