---
---

<span class="header-tile" id="header-azulejo">
    <noscript>
        <img
            src="/azulejo/001.jpg"
            width="32"
            height="32"
            alt="iammatthias"
        />
    </noscript>
</span>

<script>
    import { mountAzulejoTile } from "@src/scripts/azulejo-tile";
    const el = document.getElementById("header-azulejo");
    if (el) {
        mountAzulejoTile(el, {
            size: 32,
            alt: "iammatthias",
            refireOnClick: true,
        });
    }
</script>

<style>
    .header-tile {
        display: inline-block;
        width: 32px;
        height: 32px;
        background: var(--color-border);
        transform: rotate(45deg);
        transform-origin: center;
        overflow: hidden;
    }

    .header-tile :global(canvas),
    .header-tile img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        user-select: none;
    }
</style>
