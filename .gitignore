# etc
# Local scratch tooling stays untracked — except the gates package.json
# advertises: the agent-surface check (`bun run build` invokes it, so it
# has to exist in CI), the smoke suite, and the overflow check.
/scripts/*
!/scripts/agent-check.mjs
!/scripts/smoke.mjs
!/scripts/overflow-check.mjs
!/scripts/snapshot-azulejos.mjs
!/scripts/snapshot-terrazzo.mjs
.gstack/
