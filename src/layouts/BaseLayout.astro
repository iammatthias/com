---
import "@styles/globals.css";
import SiteMenu from "@components/SiteMenu.astro";
import HeaderTile from "@components/HeaderTile.astro";
import Schema from "@components/Schema.astro";
import Breadcrumbs, {
    type BreadcrumbItem,
} from "@components/Breadcrumbs.astro";
import { isPreview } from "@lib/preview";
import { Font } from "astro:assets";
import { SITE_IDENTITY } from "@lib/agent-surface";

interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
    ogType?: "website" | "article";
    canonical?: string | URL;
    noindex?: boolean;
    breadcrumbs?: BreadcrumbItem[];
    article?: {
        publishedTime: string;
        modifiedTime?: string;
    };
    profilePage?: boolean;
    markdownHref?: string;
    pagination?: { prev?: string | null; next?: string | null };
    faq?: Array<{ question: string; answer: string }>;
}

const SITE_NAME = "iammatthias";
const SITE_URL = "https://iammatthias.com";
const DEFAULT_DESCRIPTION = SITE_IDENTITY.tagline;

const {
    title,
    description = DEFAULT_DESCRIPTION,
    ogImage = "/",
    ogType = "website",
    canonical,
    noindex = false,
    breadcrumbs = [],
    article,
    profilePage = false,
    markdownHref,
    pagination,
    faq,
} = Astro.props;

const siteOrigin = Astro.site?.toString() ?? SITE_URL;
const canonicalURL = canonical
    ? new URL(canonical, siteOrigin)
    : new URL(Astro.url.pathname, siteOrigin);

const isAbsolute = /^https?:\/\//i.test(ogImage);
const ogOrigin = import.meta.env.DEV
    ? "http://localhost:8787"
    : "https://og.iammatthias.com";
const ogImageURL = isAbsolute ? new URL(ogImage) : new URL(ogImage, ogOrigin);

const fullTitle = title ? `${title} — ${SITE_NAME}` : SITE_NAME;
const ogTitle = title ?? SITE_NAME;

const previewMode = Astro.isPrerendered ? false : isPreview(Astro);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <meta name="generator" content={Astro.generator} />
        <meta name="color-scheme" content="light dark" />
        <meta
            name="theme-color"
            content="#f5f2e9"
            media="(prefers-color-scheme: light)"
        />
        <meta
            name="theme-color"
            content="#151a26"
            media="(prefers-color-scheme: dark)"
        />

        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        {noindex ? (
            <meta name="robots" content="noindex,nofollow" />
        ) : (
            <>
                <meta
                    name="robots"
                    content="max-snippet:-1, max-image-preview:large, max-video-preview:-1"
                />
                <link rel="canonical" href={canonicalURL} />
            </>
        )}

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

        <Font
            cssVariable="--font-metamorphous"
            preload={[{ subset: "latin" }]}
        />

        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={ogTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageURL} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogTitle} />
        {article && (
            <>
                <meta
                    property="article:published_time"
                    content={article.publishedTime}
                />
                {article.modifiedTime && (
                    <meta
                        property="article:modified_time"
                        content={article.modifiedTime}
                    />
                )}
            </>
        )}
        <meta name="twitter:card" content="summary_large_image" />

        <Schema
            siteOrigin={siteOrigin}
            siteName={SITE_NAME}
            canonical={canonicalURL.toString()}
            title={ogTitle}
            description={description}
            image={ogImageURL.toString()}
            breadcrumbs={breadcrumbs}
            article={article}
            profilePage={profilePage}
            faq={faq}
        />

        <link
            rel="alternate"
            type="application/rss+xml"
            title={`${SITE_NAME} RSS`}
            href="/rss.xml"
        />
        <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
        {markdownHref && (
            <link
                rel="alternate"
                type="text/markdown"
                title="Markdown version"
                href={markdownHref}
            />
        )}
        {pagination?.prev && <link rel="prev" href={pagination.prev} />}
        {pagination?.next && <link rel="next" href={pagination.next} />}

        <slot name="head" />
    </head>
    <body>
        {previewMode && (
            <div class="preview-banner" role="status">
                <span>Preview — showing unpublished drafts</span>
                <a href={`${Astro.url.pathname}?preview=0`}>exit</a>
            </div>
        )}
        <header>
            <slot name="header">
                <a href="/">home</a>
                <HeaderTile />
                <a href="/menu" data-menu-trigger>menu</a>
            </slot>
        </header>

        <main>
            {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
            <slot />
        </main>

        <footer>
            <slot name="footer">
                <small>© {new Date().getFullYear()} Matthias Jordan</small>
            </slot>
        </footer>

        <SiteMenu />

        <script>
            import "@src/scripts/clear-figure-placeholders";
            import "@src/scripts/selection-gradient";
        </script>
    </body>
</html>

<style>
    body {
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: var(--pad);
        gap: var(--gap);
    }

    .preview-banner {
        position: sticky;
        top: 0;
        z-index: 20;
        width: 100%;
        max-width: var(--content-max);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--space-3);
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius);
        background: var(--color-fg);
        color: var(--color-bg);
        font-family: var(--font-mono);
        font-size: var(--fs-xs);
        letter-spacing: 0.02em;
    }

    .preview-banner a {
        color: inherit;
        text-decoration: underline;
        font-weight: var(--fw-medium);
    }

    header,
    footer {
        flex: 0 0 auto;
        width: 100%;
        max-width: var(--content-max);
    }

    header {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: var(--space-4);
    }

    header > :global(:first-child) {
        justify-self: start;
    }

    header > :global(:last-child) {
        justify-self: end;
    }

    main {
        flex: 1 0 auto;
        width: 100%;
        max-width: var(--content-max);
        display: flex;
        flex-direction: column;
    }

    main > :global(* + *) {
        margin-top: var(--space-8);
    }
    main > :global(.page-header + *) {
        margin-top: var(--space-7);
    }
    main > :global(.breadcrumbs + *) {
        margin-top: var(--space-5);
    }
</style>
